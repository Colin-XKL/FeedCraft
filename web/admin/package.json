{
  "name": "feed-craft-admin-panel",
  "description": "FeedCraft admin panel",
  "version": "1.0.0",
  "private": true,
  "author": "Colin",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ./config/vite.config.dev.ts",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "report": "cross-env REPORT=true npm run build",
    "preview": "npm run build && vite preview --host",
    "test": "vitest run",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,css,less,scss,html,json,md,mdx,yml,yaml}\"",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.11",
    "echarts": "^6.1.0",
    "events": "^3.3.0",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "js-md5": "^0.8.3",
    "limax": "^4.2.3",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "query-string": "^9.4.1",
    "rss-parser": "~3.13.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.39",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@arco-plugins/vite-vue": "^1.4.6",
    "@arco-themes/vue-colinx-studio": "^0.0.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/js-beautify": "^1.14.3",
    "@types/lodash": "^4.17.24",
    "@types/mockjs": "^1.0.10",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.5.2",
    "code-inspector-plugin": "^1.6.2",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "less": "^4.6.7",
    "lint-staged": "^17.0.8",
    "mockjs": "^1.1.0",
    "postcss": "^8.5.16",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.1",
    "rollup": "^4.62.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china",
    "gifsicle": "5.2.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
